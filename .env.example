# LLM: users supply their own Groq key in the Streamlit UI.
# Do not configure a shared GROQ_API_KEY on the public backend.

# Backend-managed optional integrations (not part of LLM BYOK)
GPLACES_API_KEY=""
TAVILY_API_KEY=""
OPENWEATHERMAP_API_KEY=""
EXCHANGE_RATE_API_KEY=""

# Streamlit frontend: URL of the FastAPI backend
API_BASE_URL="https://ai-trip-planner-api-ltsk.onrender.com"

# Optional comma-separated browser origins if the API is called cross-origin.
CORS_ALLOWED_ORIGINS="*"
